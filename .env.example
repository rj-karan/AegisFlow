# Copy to .env. Compose reads this file automatically; the Go binaries read
# the same names from the environment. Nothing here is a real secret.

# dev | test | prod. Changes log format (text vs JSON) and cookie flags.
AEGIS_ENV=dev

# Listen address for the API.
AEGIS_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# Postgres password used by Compose for the local database only.
POSTGRES_PASSWORD=aegis

# Connection strings when running binaries outside Compose.
DATABASE_URL=postgres://aegis:aegis@127.0.0.1:5432/aegis?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

# Graceful shutdown budget.
AEGIS_SHUTDOWN_TIMEOUT=10s
